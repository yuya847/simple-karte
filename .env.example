ANTHROPIC_API_KEY=
# Supabase (記録の保存。なければ保存しない)。値はここに書かず、Vercel の環境変数と自分の .env.local に入れる
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 手元で Orthanc（無料の DICOM サーバー）を試すときだけ（docs/dicom-local.md）。localhost だけ・Vercel では使わない
LOCAL_ORTHANC_URL=
# スマートフォンへの通知（Web Push。なければ「この端末に通知を受ける」は押せない）。鍵の組は npx web-push generate-vapid-keys で作り、値はここに書かず Vercel の環境変数と自分の .env.local に入れる
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
